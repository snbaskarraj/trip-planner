# Copy to backend/.env for local overrides. Never commit the real file.
# Optional. If unset, the wrapper uses Open-Meteo (no key) then still
# returns {"status":"unavailable"} on any failure/timeout.
WEATHER_API_KEY=
WEATHER_TIMEOUT_SECONDS=4
DATABASE_URL=sqlite:///./trip_planner.db
# Comma-separated browser origins. On Render, set this to the Vercel URL
# (e.g. https://your-app.vercel.app). *.vercel.app is already allowed by regex.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
